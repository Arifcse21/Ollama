# Example Modelfile for reduced context
FROM qwen2.5-coder:7b

# parameter forces only 10 layers onto your 2GB VRAM, 
# leaving the other ~20+ layers for your 16GB system RAM.
PARAMETER num_gpu 1

# Set context window to 16K tokens (reduced from default)
PARAMETER num_ctx 2048

# Optional: Adjust temperature for more consistent output
PARAMETER temperature 0.7

# Optional: Set repeat penalty
PARAMETER repeat_penalty 1.1
